align: center}\n}\n</style><main>\n  \n  <nav class=\"hero-nav\" aria-label=\"页面导览\">\n    <a href=\"#plans\">服务套餐</a>\n    <a href=\"#clients\">客户端支持</a>\n    <a href=\"#setup\">配置流程</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n\n  \n  <section class=\"hero-grid\">\n    <article class=\"hero-content\">\n      <span class=\"hero-tag\">Node &amp; Network Protocol</span>\n      <h1>网之易(NetEase)</h1>\n      <p>规则分流，多端协同。提供明确的套餐配额与标准协议接口，随取随用，保持通信干净利落。</p>\n      <div class=\"hero-actions\">\n        <a href=\"#plans\" class=\"btn-primary\">浏览接入方案</a>\n        <a href=\"#setup\" class=\"btn-secondary\">查看配置指南</a>\n      </div>\n    </article>\n\n    <aside class=\"hero-panel\">\n      <div>\n        <div class=\"panel-head\">\n          <h2>系统运行面板</h2>\n        </div>\n        <div class=\"panel-list\">\n          <div class=\"panel-item\">\n            <span>支持协议类型</span>\n            <span>Shadowsocks / V2Ray / Clash</span>\n          </div>\n          <div class=\"panel-item\">\n            <span>网络分流策略</span>\n            <span>ACL 规则 / 域名列表匹配</span>\n          </div>\n          <div class=\"panel-item\">\n            <span>在线并发计算</span>\n            <span>依据套餐上限动态限制</span>\n          </div>\n          <div class=\"panel-item\">\n            <span>订阅更新周期</span>\n            <span>24 小时自动刷新</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"panel-status\">\n        当前集群节点调度正常。建议每月核对设备数与配额使用情况。\n      </div>\n    </aside>\n  </section>\n\n  \n  <section id=\"plans\">\n    <div class=\"section-header\">\n      <h2>服务方案配置</h2>\n      <p>按月计费，支持按年付结算。配额按自然月或周期重置。</p>\n    </div>\n\n    <div class=\"plans-stack\">\n      \n      <article class=\"plan-card\">\n        <div class=\"plan-left\">\n          <h3>基础版</h3>\n          <div class=\"plans-prices\">\n            <span class=\"price-main\">¥15</span>\n            <span class=\"price-sub\">/月 (按年付仅需 ¥150/年)</span>\n          </div>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-btn\">选定基础版</a>\n        </div>\n      </article>\n\n      \n      <article class=\"plan-card featured\">\n        <div class=\"plan-left\">\n          <span class=\"plan-badge\">主力推荐</span>\n          <h3>旗舰版</h3>\n          <div class=\"plans-prices\">\n            <span class=\"price-main\">¥35</span>\n            <span class=\"price-sub\">/月 (按年付仅需 ¥350/年)</span>\n          </div>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-btn\">立即选定</a>\n        </div>\n      </article>\n\n      \n      <article class=\"plan-card\">\n        <div class=\"plan-left\">\n          <h3>团队版</h3>\n          <div class=\"plans-prices\">\n            <span class=\"price-main\">¥85</span>\n            <span class=\"price-sub\">/月 (按年付仅需 ¥850/年)</span>\n          </div>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-btn\">选定团队版</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\" class=\"clients-section\">\n    <div class=\"section-header\">\n      <h2>客户端接入支持</h2>\n      <p>网之易(NetEase) 兼容主流平台开源客户端，导入订阅即可载入分流规则。</p>\n    </div>\n\n    <div class=\"client-grid\">\n      <div class=\"client-box\">\n        <h4>Windows</h4>\n        <p>适配 Clash Verge、v2rayN 等通用客户端。复制订阅链接后通过剪贴板直接导入并启动系统代理。</p>\n        <a href=\"#setup\" class=\"client-link\">查看接入步骤 →</a>\n      </div>\n      <div class=\"client-box\">\n        <h4>macOS</h4>\n        <p>适配 Clash Verge Rev、Surge 等工具。支持增强模式与开机自启，按需配置路由黑白名单。</p>\n        <a href=\"#setup\" class=\"client-link\">查看接入步骤 →</a>\n      </div>\n      <div class=\"client-box\">\n        <h4>iOS / iPadOS</h4>\n        <p>支持 Shadowrocket、Loon、Stash 等代理软件。扫码或一键唤起应用，几秒完成节点同步。</p>\n        <a href=\"#setup\" class=\"client-link\">查看接入步骤 →</a>\n      </div>\n      <div class=\"client-box\">\n        <h4>Android</h4>\n        <p>支持 Clash Meta for Android、v2rayNG。具备分应用代理功能，避免局域网内其他应用受干扰。</p>\n        <a href=\"#setup\" class=\"client-link\">查看接入步骤 →</a>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"setup\" class=\"clients-section\">\n    <div class=\"section-header\">\n      <h2>快速使用流程</h2>\n      <p>三步建立网络连接，轻量配置，不留冗余步骤。</p>\n    </div>\n\n    <div class=\"client-grid\">\n      <div class=\"client-box\">\n        <h4>第一步：获取专属订阅</h4>\n        <p>在用户控制台选定服务方案，复制通用订阅 URL 或直接导出 Clash 格式配置文件。</p>\n      </div>\n      <div class=\"client-box\">\n        <h4>第二步：导入客户端配置</h4>\n        <p>打开本地客户端，选择新建配置，粘贴订阅链接并点击更新。节点列表将自动列出。</p>\n      </div>\n      <div class=\"client-box\">\n        <h4>第三步：选择路由规则</h4>\n        <p>将模式切换为“Rule / 规则”模式。浏览器发起网络请求时将自动实现国内外分流。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\" class=\"faq-section\">\n    <div class=\"section-header\">\n      <h2>常见问题解答</h2>\n      <p>关于流量结算、设备上限以及配置更新的说明。</p>\n    </div>\n\n    <div class=\"faq-stack\">\n      <details>\n        <summary>订阅流量是如何计算与重置的？</summary>\n        <p>流量按套餐周期重置。当下行与上行产生数据时计入配额，未用完的流量不结转至下一周期。</p>\n      </details>\n\n      <details>\n        <summary>超出设备同时在线限制会有什么影响？</summary>\n        <p>系统按 IP 与活跃连接数判定在线设备。超出套餐限制时，较早建立连接的设备可能被断开连接。</p>\n      </details>\n\n      <details>\n        <summary>节点列表无法更新如何排查？</summary>\n        <p>请核实网络本地 DNS 解析是否正常。若链接提示超时，可尝试切换本地网络或检查订阅链接完整性。</p>\n      </details>\n\n      <details>\n        <summary>是否支持随时更改或升级套餐？</summary>\n        <p>支持在管理后台直接补差价更换规格。新配额与设备数将在新方案生效后立即更新。</p>\n      </details>\n    </div>\n  </section>\n\n  \n  <footer>\n    <span>网之易(NetEase) 系统规格指南</span>\n    <span>请遵守网络使用相关规范与属地法规</span>\n  </footer>\n</main>",
